# Firebase WEB config. These values identify your project and are meant to be public
# (they ship in the browser bundle). Security comes from firestore.rules / storage.rules,
# not from hiding these. Restrict the API key to your site's domains in Google Cloud Console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_ADMIN_EMAIL=you@example.com

# Public address of the site, used for canonical links, the sitemap and social previews.
# On Vercel this is filled in automatically from the production domain; set it when you add a custom domain.
# VITE_SITE_URL=https://www.example.com

# Optional: the verification code from Google Search Console ("HTML tag" method, the content="..." value).
# VITE_GOOGLE_SITE_VERIFICATION=

# Optional: the verification code from Bing Webmaster Tools ("HTML meta tag" method, the content="..." value).
# VITE_BING_SITE_VERIFICATION=

# Optional: Google Analytics 4 measurement id (G-XXXXXXXXXX). Nothing is loaded unless this is set.
# Analytics cookies may need a consent notice for visitors in some regions.
# VITE_GA_MEASUREMENT_ID=

# ---- SERVER-ONLY secrets (used by the functions in /api). Never prefix these with VITE_. ----
# Set them in Vercel: Project -> Settings -> Environment Variables (and in .env for `vercel dev`).

# Cloudinary: image and video uploads from the admin dashboard. The API secret never reaches the browser;
# /api/cloudinary-sign signs each upload after checking that the owner is signed in.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (contact notifications + replying from the dashboard). Gmail works with an App Password:
# Google Account -> Security -> 2-Step Verification -> App passwords.
SMTP_USER=you@gmail.com
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM_NAME=Muhammad Umer Rizwan
# Where contact notifications are delivered (defaults to VITE_ADMIN_EMAIL).
# ADMIN_EMAIL=you@example.com
